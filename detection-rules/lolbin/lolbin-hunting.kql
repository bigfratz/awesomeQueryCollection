// ============================================================
// LOLBin HUNTING — analyst-driven exploration, not wired to automation.
//
// Unlike lolbin-severity-tiers.kql (static argument patterns -> fixed
// severity -> automation trigger), these queries surface candidates for
// human review: rare/anomalous usage and corroborating network/file
// activity. No Severity field — triage is the point of running these.
// ============================================================


// ------------------------------------------------------------
// 1. Rare LOLBin usage per device — baseline-relative anomaly, not a
//    static signature. Catches abuse you didn't write a rule for.
// ------------------------------------------------------------
let lolbins = dynamic(["certutil.exe", "bitsadmin.exe", "mshta.exe", "regsvr32.exe",
    "installutil.exe", "regasm.exe", "regsvcs.exe", "msbuild.exe",
    "cmstp.exe", "odbcconf.exe", "wuauclt.exe", "pcalua.exe"]);
DeviceProcessEvents
| where Timestamp > ago(30d)
| where FileName in~ (lolbins)
| summarize ExecCount = count(), Devices = dcount(DeviceId), SampleCmd = any(ProcessCommandLine)
    by FileName, DeviceName
| where ExecCount <= 3 and Devices == 1   // rare AND isolated to one host
| sort by ExecCount asc


// ------------------------------------------------------------
// 2. LOLBin process correlated with a network connection in the same
//    window — a certutil/bitsadmin/curl hit that also touches the
//    network is a much stronger candidate than the process event alone.
// ------------------------------------------------------------
let lookback = 7d;
let lolbins = dynamic(["certutil.exe", "bitsadmin.exe", "mshta.exe", "curl.exe", "wget.exe", "powershell.exe", "pwsh.exe"]);
DeviceProcessEvents
| where Timestamp > ago(lookback)
| where FileName in~ (lolbins)
| project ProcessTime = Timestamp, DeviceId, DeviceName, AccountName, FileName, ProcessCommandLine,
    InitiatingProcessFileName, ReportId
| join kind=inner (
    DeviceNetworkEvents
    | where Timestamp > ago(lookback)
    | where ActionType in ("ConnectionSuccess", "ConnectionAttempted")
    | project NetTime = Timestamp, DeviceId, RemoteIP, RemoteUrl, RemotePort, InitiatingProcessFileName
) on DeviceId
| where NetTime between (ProcessTime .. ProcessTime + 2m)   // network activity shortly after process start
| project ProcessTime, DeviceName, AccountName, FileName, ProcessCommandLine, RemoteIP, RemoteUrl, RemotePort
| sort by ProcessTime desc


// ------------------------------------------------------------
// 3. LOLBin process followed by a file write — confirms a download
//    cradle actually dropped something, vs. a failed/aborted attempt.
// ------------------------------------------------------------
let lookback = 7d;
let lolbins = dynamic(["certutil.exe", "bitsadmin.exe", "mshta.exe", "curl.exe", "wget.exe"]);
DeviceProcessEvents
| where Timestamp > ago(lookback)
| where FileName in~ (lolbins)
| project ProcessTime = Timestamp, DeviceId, DeviceName, AccountName, FileName, ProcessCommandLine
| join kind=inner (
    DeviceFileEvents
    | where Timestamp > ago(lookback)
    | where ActionType == "FileCreated"
    | project FileTime = Timestamp, DeviceId, FileName = FileName, FolderPath, SHA256
) on DeviceId
| where FileTime between (ProcessTime .. ProcessTime + 1m)
| project ProcessTime, DeviceName, AccountName, FileName, ProcessCommandLine, DroppedFile = FolderPath, SHA256
| sort by ProcessTime desc


// ------------------------------------------------------------
// 4. cmd.exe spawning a script engine (T1059) — moved out of the tiered
//    rules: far too benign as an alert (batch wrappers, logon scripts, RMM,
//    installers). As a hunt it's still useful for eyeballing outliers, so
//    surface it aggregated by command line rather than per-event, and drop
//    the known-good CompanyPortal launcher.
// ------------------------------------------------------------
DeviceProcessEvents
| where Timestamp > ago(7d)
| where InitiatingProcessFileName == "cmd.exe"
    and FileName in~ ("powershell.exe", "pwsh.exe", "wscript.exe", "cscript.exe")
| where not(ProcessCommandLine contains @"CompanyPortalStartup\LaunchCompanyPortal.ps1")
| summarize Count = count(), Devices = dcount(DeviceId), FirstSeen = min(Timestamp), LastSeen = max(Timestamp)
    by FileName, ProcessCommandLine, InitiatingProcessParentFileName
| sort by Count asc   // rarest command lines first — the interesting tail


// ------------------------------------------------------------
// 5. Interpreter (perl/python/ruby) running payload-ish content (T1059.006) —
//    moved out of the tiered rules (low yield, high FP). Fixes the original
//    latent bug (FileName-based, not ProcessCommandLine == "python.exe"),
//    drops java.exe (enormous noisy command lines), and narrows the keyword
//    list to genuinely-suspicious tokens (dropped bare invoke/payload/http).
//    Known-good local apps excluded. Hunt only — triage the results.
// ------------------------------------------------------------
DeviceProcessEvents
| where Timestamp > ago(7d)
| where FileName in~ ("perl.exe", "python.exe", "ruby.exe")
| where ProcessCommandLine matches regex @"(?i)(base64|shellcode|-e\s|exec\(|socket|/dev/tcp|frombase64|iex|invoke-expression|downloadstring)"
| where not(ProcessCommandLine has_any ("\\AppData\\Roaming\\XNP\\lsp-home", "ElsterAuthenticator", "BNOTK SAK lite"))
| project Timestamp, DeviceName, AccountName, FileName, ProcessCommandLine, InitiatingProcessFileName
| sort by Timestamp desc
