// Rule: T3-LOLBAS-malicious-respond
// Execution / defense-evasion / initial-access chains — rare or no benign
// explanation, or the action itself is the malicious step. Safe to wire to
// the most aggressive downstream automation ("respond").
//
// One of three severity tiers (T1 signals / T2 suspicious / T3 malicious).
// All three share the identical GLOBAL EXCLUSIONS header below — keep in sync.
DeviceProcessEvents
// === GLOBAL EXCLUSIONS v1 — keep identical across all LOLBAS rules ===
| where DeviceName startswith "X"
| where not(InitiatingProcessAccountName has_any ("adm_", "administrator", "system", "lokaler dienst", "defaultuser0", "<svc_account_1>", "<svc_account_2>"))
| where isnotempty(InitiatingProcessAccountName)
//| where not(InitiatingProcessFolderPath has_any ("C:\\Program Files (x86)\\Microsoft Visual Studio",
//    "C:\\Program Files\\Microsoft Visual Studio\\2022\\Professional\\"))
| where not(InitiatingProcessParentFileName == "x" and (InitiatingProcessCommandLine contains "x" and InitiatingProcessCommandLine contains "x"))
| where not(ProcessCommandLine matches regex @"x")
// === END GLOBAL EXCLUSIONS v1 ===
| where
    (1 == 2)   // inert seed — every detection below starts with `or`, so any line toggles freely
    or (ProcessCommandLine has "bcdedit.exe" and ProcessCommandLine has_any ("/set", "/deletevalue"))
    or (ProcessCommandLine has "bitsadmin.exe" and ProcessCommandLine has_any ("transfer", "download"))
    or (ProcessCommandLine has "certutil.exe" and ProcessCommandLine matches regex "(?i).*urlcache.*split.*f.*")
    or (ProcessCommandLine has "installutil.exe")
    or (ProcessCommandLine has "mavinject.exe")
    or (ProcessCommandLine has "mshta.exe" and ProcessCommandLine has_any ("http", "https"))
    or (ProcessCommandLine has "msiexec.exe" and ProcessCommandLine matches regex "(?i).*(http|https).*")
    or (ProcessCommandLine has "netsh.exe" and ProcessCommandLine has "interface portproxy add")
    // FIX: was (has "cmd.exe" and has "-enc") — "-enc" is a PowerShell switch. Now targets
    // powershell/pwsh plus the download-cradle verbs.
    or (ProcessCommandLine has_any ("powershell.exe", "pwsh.exe")
        and ProcessCommandLine has_any ("-enc", "-encodedcommand", "frombase64string", "downloadstring", "downloadfile", "net.webclient"))
    or (ProcessCommandLine has "powershell.exe" and ProcessCommandLine matches regex "(?i).*i(e|x)(.*?)\\(")
    // NOTE: procdump -ma/lsass moved out — it's Sysinternals (own rule) + credential access,
    // so it belongs in T4 (all-context) not here. See ../t4-lolbas-sysinternals-privileged-context-isolate.kql.
    or (ProcessCommandLine has "regsvr32.exe" and ProcessCommandLine matches regex "(?i).*\\/i:(http|https).*")
    or (ProcessCommandLine has "rundll32.exe" and ProcessCommandLine has_any ("javascript:", "vbscript:", "RunHTMLApplication"))
    // NOTE: wevtutil cl (event-log clear) moved to T4 — it runs in SYSTEM/admin context that the
    // T3 GLOBAL header excludes, so the no-exclusion T4 header is the right scope. Was duplicated
    // in both tiers; T4 now solely owns it. See ../t4-lolbas-sysinternals-privileged-context-isolate.kql.
    or (ProcessCommandLine has "wlrmdr.exe" and ProcessCommandLine has_all ("-s", "-f", "-t", "-m", "-a", "-u"))
    // NEW: parent -> child malspam / macro chain (initial access -> execution). Document apps,
    // archivers, and script hosts directly spawning a LOLBin. Outlook/browsers deliberately
    // excluded (too noisy). RunAction.vbs is the contentACCESS add-in (legit).
    or (InitiatingProcessFileName in~ ("winword.exe", "excel.exe", "powerpnt.exe", "onenote.exe",
            "msaccess.exe", "mspub.exe", "visio.exe", "acrord32.exe", "7z.exe", "winrar.exe",
            "wscript.exe", "cscript.exe")
        and FileName in~ ("certutil.exe", "bitsadmin.exe", "mshta.exe", "rundll32.exe", "regsvr32.exe",
            "wscript.exe", "cscript.exe", "powershell.exe", "pwsh.exe", "curl.exe", "msiexec.exe",
            "installutil.exe", "wmic.exe", "msbuild.exe")
        and not(ProcessCommandLine contains "contentACCESSForm\\RunAction.vbs"))
| extend Severity = "High"
| order by Timestamp desc
