// ============================================================
// LOLBin detection — single combined "early-stage" variant.
//
// Flat rule (no severity tiers) scoped to the first few ATT&CK stages
// (recon / initial access / execution / light persistence), with a
// global exception header. Company-specific exclusions are redacted as
// "x" — restore them from your environment before deploying.
//
// Changes vs the prior working version are marked "FIX" / "NEW".
// ============================================================
DeviceProcessEvents
//define exceptions (global — company-specific values redacted as "x"):
| where DeviceName startswith "X"
| where not(InitiatingProcessAccountName has_any ("adm_", "Administrator", "system", "lokaler dienst", "defaultuser0", "devopsserviceuser", "System", "hmsupport"))
| where isnotempty(InitiatingProcessAccountName)
//| where not(InitiatingProcessFolderPath has_any ("C:\\Program Files (x86)\\Microsoft Visual Studio",
//    "C:\\Program Files\\Microsoft Visual Studio\\2022\\Professional\\"))
| where not(InitiatingProcessParentFileName == "x" and (InitiatingProcessCommandLine contains "x" and InitiatingProcessCommandLine contains "x"))
| where not(ProcessCommandLine matches regex @"x")   // FIX: added the missing closing paren
//define scope:
| where
    (ProcessCommandLine has "agentexecutor.exe" and ProcessCommandLine has "-powershell") or
    (ProcessCommandLine has "arp.exe" and ProcessCommandLine has "/a") or
    (ProcessCommandLine has "attrib.exe" and ProcessCommandLine has_any ("+h", "-h", "+s", "-s")) or
    (ProcessCommandLine has "bcdedit.exe" and ProcessCommandLine has_any ("/set", "/deletevalue")) or
    (ProcessCommandLine has "bitsadmin.exe" and ProcessCommandLine has_any ("transfer", "download")) or
    (ProcessCommandLine has "certutil.exe" and ProcessCommandLine matches regex "(?i).*urlcache.*split.*f.*") or
    // FIX: was (has "cmd.exe" and has "-enc") — "-enc" is a PowerShell switch, not cmd's, so it
    // never caught encoded execution. Now targets powershell/pwsh and also the download-cradle verbs.
    (ProcessCommandLine has_any ("powershell.exe", "pwsh.exe")
        and ProcessCommandLine has_any ("-enc", "-encodedcommand", "frombase64string", "downloadstring", "downloadfile", "net.webclient")) or
    (ProcessCommandLine has "dnscmd.exe") or
    (ProcessCommandLine has "installutil.exe") or
    (ProcessCommandLine has "ipconfig.exe" and ProcessCommandLine has "/displaydns") or
    (ProcessCommandLine has "mavinject.exe") or
    (ProcessCommandLine has "mshta.exe" and ProcessCommandLine has_any ("http", "https")) or
    (ProcessCommandLine has "msiexec.exe" and ProcessCommandLine matches regex "(?i).*(http|https).*") or
    (ProcessCommandLine has "msbuild.exe") or
    (ProcessCommandLine has "netsh.exe" and ProcessCommandLine has "interface portproxy add") or
    (ProcessCommandLine has "netstat" and ProcessCommandLine has_any ("-an", "-o")) or
    (ProcessCommandLine has "nmap.exe") or
    (ProcessCommandLine has "powershell.exe" and ProcessCommandLine matches regex "(?i).*i(e|x)(.*?)\\(") or
    // FIX: was ProcessCommandLine in (...) (exact-string match); use FileName in~ so it keys on
    // the actual process, matching real command lines regardless of args/casing.
    (FileName in~ ("curl.exe", "wget.exe")
        and ProcessCommandLine has_any ("-o", "--output", "-d", "--data")) or
    // FIX: was (has "procdump.exe" or has "mavinject.exe") — fired on any procdump invocation and
    // duplicated the mavinject line above. Now requires dump-relevant args.
    (ProcessCommandLine has "procdump.exe" and ProcessCommandLine has_any ("-ma", "lsass")) or
    (ProcessCommandLine has "regsvr32.exe" and ProcessCommandLine matches regex "(?i).*\\/i:(http|https).*") or
    (ProcessCommandLine has "robocopy.exe" and ProcessCommandLine has_any ("/mir", "/e", "/copyall")) or
    (ProcessCommandLine has "rundll32.exe" and ProcessCommandLine has_any ("javascript:", "vbscript:", "RunHTMLApplication")) or
    (ProcessCommandLine has "sc.exe" and ProcessCommandLine has_any ("create", "config")) or
    // NOTE: "qe" is a read-only log query (benign); "cl" is log clearing (anti-forensics). Kept
    // both for broad discovery context in this flat rule — split them if you later tier by severity.
    (ProcessCommandLine has "wevtutil.exe" and ProcessCommandLine has_any ("cl", "qe")) or
    (ProcessCommandLine has "whoami.exe" and ProcessCommandLine has_any ("/priv", "/groups")) or
    (ProcessCommandLine has "wlrmdr.exe" and ProcessCommandLine has_all ("-s", "-f", "-t", "-m", "-a", "-u")) or
    // FIX: was ProcessCommandLine in (...); switched to FileName in~ (the unambiguous, intended form).
    (FileName in~ ("perl.exe", "python.exe", "ruby.exe", "java.exe")
        and ProcessCommandLine matches regex "(?i).*(http|https|base64|shellcode|obfuscate|invoke|payload).*"
        and not(ProcessCommandLine has_any ("x"))) or
    // -- optional persistence additions (early-ish stages; uncomment to include) --
    // (ProcessCommandLine has "schtasks.exe" and ProcessCommandLine has "/create") or
    // (ProcessCommandLine has "reg.exe" and ProcessCommandLine has "add" and ProcessCommandLine has_any ("\\Run", "\\RunOnce")) or
    // (ProcessCommandLine has "wmic.exe" and ProcessCommandLine has_all ("process", "call", "create")) or
    // NEW: parent -> child malspam / macro chain (initial access -> execution). Highest-value
    // early-stage signal — catches a document/archiver/script-host directly spawning a LOLBin even
    // when the LOLBin's own args look normal. Outlook/browsers deliberately excluded (too noisy via
    // protocol handlers/downloads/add-ins). RunAction.vbs is the contentACCESS add-in (legit).
    (InitiatingProcessFileName in~ ("winword.exe", "excel.exe", "powerpnt.exe", "onenote.exe",
            "msaccess.exe", "mspub.exe", "visio.exe", "acrord32.exe", "7z.exe", "winrar.exe",
            "wscript.exe", "cscript.exe")
        and FileName in~ ("certutil.exe", "bitsadmin.exe", "mshta.exe", "rundll32.exe", "regsvr32.exe",
            "wscript.exe", "cscript.exe", "powershell.exe", "pwsh.exe", "curl.exe", "msiexec.exe",
            "installutil.exe", "wmic.exe", "msbuild.exe")
        and not(ProcessCommandLine contains "contentACCESSForm\\RunAction.vbs"))
| order by Timestamp desc
