// Rule: T1-LOLBAS-signals-watch
// Discovery/context and unusual tooling — lowest-confidence signals.
// Wire to enrichment/ticketing ("watch"), not aggressive automation.
//
// One of three severity tiers (T1 signals / T2 suspicious / T3 malicious).
// Shared exclusions come from the saved function FilteredProcessEvents (see
// shared-functions.kql) — edit the device prefix / service accounts / noise
// filters there, once, not per rule.
FilteredProcessEvents(true)   // excludeAdmin = true (GLOBAL — drops admin/SYSTEM/service noise)
| where
    (1 == 2)   // inert seed — every detection below starts with `or`, so any line toggles freely
    or (ProcessCommandLine has "arp.exe" and ProcessCommandLine has "/a")
    or (ProcessCommandLine has "dnscmd.exe")
    or (ProcessCommandLine has "ipconfig.exe" and ProcessCommandLine has "/displaydns")
    or (ProcessCommandLine has "netstat" and ProcessCommandLine has_any ("-an", "-o"))
    or (ProcessCommandLine has "nmap.exe")
    or (ProcessCommandLine has "wevtutil.exe" and ProcessCommandLine has "qe")   // read-only query; "cl" (clear) lives in the T4 rule
    or (ProcessCommandLine has "whoami.exe" and ProcessCommandLine has_any ("/priv", "/groups"))
| extend Severity = "Low"
| order by Timestamp desc
